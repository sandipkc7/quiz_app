# ============================================
# QuizMaster — Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Database
DB_HOST=localhost
DB_NAME=quiz_db
DB_USER=root
DB_PASS=

# Application
APP_NAME=QuizMaster
BASE_URL=/quiz
APP_ENV=development

# Admin (used for initial setup)
ADMIN_EMAIL=admin@quizapp.com

# ============================================
# QuizMaster — Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Database
DB_HOST=localhost
DB_NAME=quiz_db
DB_USER=root
DB_PASS=

# Application
APP_NAME=QuizMaster
BASE_URL=/quiz
# Optional: Set explicit APP_URL for emails and external links (e.g. https://quiz.sandipkc.com.np)
# APP_URL=https://quiz.sandipkc.com.np
APP_ENV=development

# Admin (used for initial setup)
ADMIN_EMAIL=admin@quizapp.com

# SMTP Mail Settings (Used for password resets and system notifications)
# Compatible with Gmail, Mailtrap, Brevo, Outlook, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=noreply@quizmaster.com
SMTP_FROM_NAME="QuizMaster Support"
